.notes/


# Export outputs
scripts/exports/
solutions/**/*.zip
solutions/**/*.zip.bak

# PAC CLI internal files
**/.portalconfig/
**/.powerpages-site/

# OS files
Thumbs.db
.DS_Store

# VS Code workspace defaults
.vscode/launch.json

# Node / Playwright
node_modules/
playwright-report/
playwright-report-live/
test-results/
test-results-*/
blob-report/

# .NET / Dataverse plugins
**/bin/
**/obj/

