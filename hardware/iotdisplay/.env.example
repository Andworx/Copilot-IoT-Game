# Copy to .env (never commit the real file — it's gitignored). kiosk-browser.sh
# reads this to know what page to show — see README.md.
#
# Root, not /kiosk/info: Power Pages has no wildcard/catch-all page for this
# Code Site's client-side (react-router BrowserRouter) routes, so a direct
# hit to /kiosk/* 404s at the platform level before the SPA ever loads. Only
# the root path is a registered Power Pages page.
KIOSK_URL=https://copilotiotgame.powerappsportals.com/
