# Optional for the first wiring smoke test. Without this value, telemetry is logged locally.
AZURE_IOT_CONNECTION_STRING=
PLINKO_STATION_SLUG=plinko-1
PLINKO_BUCKET=1
PLINKO_LIT_BUCKET=1
PLINKO_BUCKET_COUNT=6
PLINKO_INPUT_PIN=17
PLINKO_DEBOUNCE_MS=200
PLINKO_POLL_MS=20# BCM pins for buckets 1..N, left to right (bucket count = number of pins).
PLINKO_BUCKET_PINS=17,27,22,23,24,25
PLINKO_LOCKOUT_MS=1000
