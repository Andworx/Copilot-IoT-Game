# Copy to .env (never commit the real file — it's gitignored) and fill in either
# the DPS settings below or the direct IoT Hub connection string fallback.

# Preferred: DPS enrollment group `iot-game-fleet`.
AZURE_IOT_DPS_ENROLLMENT_GROUP_ID=iot-game-fleet
AZURE_IOT_DPS_ID_SCOPE=0ne011EB47B
AZURE_IOT_DPS_REGISTRATION_ID=copilotiotpanel
AZURE_IOT_DPS_SYMMETRIC_KEY=<derived-device-key>

# Rollback/fallback: direct IoT Hub device connection string.
# AZURE_IOT_CONNECTION_STRING=HostName=<hub-name>.azure-devices.net;DeviceId=<panel-pi-device-id>;SharedAccessKey=<key>

# Required for live demos: lets the Pi follow the active kiosk mode instead of falling
# back to thermostat.
MODE_STATE_URL=https://func-aw-azcom-iot-game.azurewebsites.net/api/kiosk-state

# Optional: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
