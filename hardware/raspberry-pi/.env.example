# Copy to .env (never commit the real file — it's gitignored) and fill in the
# panel Pi's existing Azure IoT Hub device connection string (GAME_MODE_PLAN.md
# §0/§4: this Pi is already registered to IoT Hub from the sibling
# copilot-iot-service project — reuse that device identity, don't provision a
# new one).
AZURE_IOT_CONNECTION_STRING=HostName=<hub-name>.azure-devices.net;DeviceId=<panel-pi-device-id>;SharedAccessKey=<key>

# Optional: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
