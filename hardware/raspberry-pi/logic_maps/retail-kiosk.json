  "lamps": [
    { "physicalPin": "LED1", "key": "ready", "label": "Ready", "when": "win" },
    { "physicalPin": "LED2", "key": "readeroffline", "label": "Reader Offline", "when": "not cardreaderreset" },
    { "physicalPin": "LED3", "key": "printerjam", "label": "Printer Jam", "when": "printerfeed" },
    { "physicalPin": "LED4", "key": "synced", "label": "Synced", "when": "networksync" }
  ],
  "win": "power and cardreaderreset and networksync",
