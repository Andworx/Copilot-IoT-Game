{
  "slug": "retail-kiosk",
  "label": "Retail Payment Kiosk",
  "dialPosition": 11,
  "isGameDevice": true,
  "switches": [
    { "physicalPin": "SW1", "key": "power", "label": "Power" },
    { "physicalPin": "SW2", "key": "cardreaderreset", "label": "Card Reader Reset" },
