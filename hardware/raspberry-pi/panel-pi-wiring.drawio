        <mxCell id="valid3" value="A port cannot be in two patch links at the same time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#334155;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="695" width="620" height="40" />
        </mxCell>
        <mxCell id="card4" value="&lt;b&gt;LIVE CHECK&lt;/b&gt;&lt;br&gt;Stop restore-and-spin-panel.service, then run .venv/bin/python3 diagnose_cables.py --watch.&lt;br&gt;No cables: bridges none, all sockets open.&lt;br&gt;One cable S1-S3: bridges ['S1 pin 4 &amp;lt;-&amp;gt; S3 pin 4']; cables [{'cable': 1, 'sockets': ['S1', 'S3']}]." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;fontSize=18;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="770" width="1320" height="110" />
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;Build checks:&lt;/b&gt; Pin 4 on each RJ-45 jack must be isolated from ground, the panel metal, all other unused RJ-45 contacts, and the switch ground rail.&lt;br&gt;&lt;b&gt;Patch cables:&lt;/b&gt; Use standard straight-through RJ-45 cables. Cable identity does not matter; only the socket pair matters.&lt;br&gt;&lt;b&gt;Rollout:&lt;/b&gt; Deploy firmware and kiosk together because telemetry cableSchema changes to panel-rj45-links/v1. See CABLE-BUILD-PLAN.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#334155;fontSize=19;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="900" width="1320" height="150" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>