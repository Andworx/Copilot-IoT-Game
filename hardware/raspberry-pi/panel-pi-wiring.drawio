        <mxCell id="wire31" value="S1-S3 plus S2-S4 | S1-S4 plus S2-S3" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=16;align=left;spacing=12;" edge="0" parent="1" vertex="1">
