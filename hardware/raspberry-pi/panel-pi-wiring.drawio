<mxfile host="app.diagrams.net" modified="2026-09-16T00:00:00.000Z" agent="Copilot" version="24.7.17" type="device">
  <diagram id="panel-pi-wiring" name="Panel Pi Wiring">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="border" value="" style="rounded=0;shadow=0;strokeColor=#333333;fillColor=none;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1320" height="820" as="geometry" />
        </mxCell>
        <mxCell id="title" value="PANEL PI WIRING - RESTORE &amp; SPIN" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="50" width="680" height="40" as="geometry" />
        </mxCell>
        <mxCell id="coord-top" value="4                 3                 2                 1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="160" y="42" width="1080" height="20" as="geometry" />
        </mxCell>
        <mxCell id="coord-left" value="A&#10;&#10;B&#10;&#10;C&#10;&#10;D" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="180" width="20" height="520" as="geometry" />
        </mxCell>
        <mxCell id="pi" value="&lt;b&gt;RASPBERRY PI 40-PIN HEADER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;BCM numbering. Switch GPIOs use pull-ups and read LOW when grounded. Socket contacts are never grounded; the scan drives one low at a time.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Inputs - switches&lt;/b&gt;&lt;br&gt;SW1 Safety 1: GPIO5 / pin 29&lt;br&gt;SW2 Safety 2: GPIO6 / pin 31&lt;br&gt;SW3 Toggle 1: GPIO13 / pin 33&lt;br&gt;SW4 Toggle 2: GPIO19 / pin 35&lt;br&gt;SW5 Keyed 1: GPIO26 / pin 37&lt;br&gt;SW6 Keyed 2: GPIO21 / pin 40&lt;br&gt;&lt;br&gt;&lt;b&gt;Cable socket contacts (pull-up in, scanned)&lt;/b&gt;&lt;br&gt;J1 pin 1: GPIO4 / pin 7&lt;br&gt;J1 pin 2: GPIO18 / pin 12&lt;br&gt;J1 pin 3: GPIO24 / pin 18&lt;br&gt;J1 pin 4: GPIO16 / pin 36&lt;br&gt;J2 pin 1: GPIO25 / pin 22&lt;br&gt;J2 pin 2: GPIO20 / pin 38&lt;br&gt;J3 pin 1: GPIO2 / pin 3&lt;br&gt;J3 pin 2: GPIO12 / pin 32&lt;br&gt;J4 pin 3: GPIO3 / pin 5&lt;br&gt;J4 pin 2: GPIO7 / pin 26&lt;br&gt;&lt;br&gt;&lt;b&gt;Outputs - LEDs&lt;/b&gt;&lt;br&gt;LED1 blue: GPIO17 / pin 11&lt;br&gt;LED2 yellow: GPIO27 / pin 13&lt;br&gt;LED3 orange: GPIO22 / pin 15&lt;br&gt;LED4 green: GPIO23 / pin 16&lt;br&gt;&lt;br&gt;&lt;b&gt;Power rails&lt;/b&gt;&lt;br&gt;GND: pins 6/9/14/20/25/30/34/39" style="rounded=1;shadow=1;strokeColor=#333333;fillColor=#FFFFFF;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="300" height="640" as="geometry" />
        </mxCell>
        <mxCell id="switches" value="&lt;b&gt;SWITCH HARNESS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;2 safety switches, 2 toggle switches, and 2 keyed switches wired as simple closures to ground.&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pi GPIO5 pin 29 → SW1 Safety switch 1 signal&lt;br&gt;Pi GPIO6 pin 31 → SW2 Safety switch 2 signal&lt;br&gt;Pi GPIO13 pin 33 → SW3 Toggle switch 1 signal&lt;br&gt;Pi GPIO19 pin 35 → SW4 Toggle switch 2 signal&lt;br&gt;Pi GPIO26 pin 37 → SW5 Keyed switch 1 signal&lt;br&gt;Pi GPIO21 pin 40 → SW6 Keyed switch 2 signal&lt;br&gt;&lt;br&gt;Other selected switch terminal(s) → GND rail&lt;br&gt;&lt;br&gt;&lt;b&gt;Electrical state&lt;/b&gt;&lt;br&gt;Open = HIGH / false&lt;br&gt;Closed to GND = LOW / true" style="rounded=1;shadow=1;strokeColor=#333333;fillColor=#FFFFFF;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="110" width="270" height="245" as="geometry" />
        </mxCell>
        <mxCell id="leds" value="&lt;b&gt;LED HARNESS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Each LED must have its own current-limiting resistor.&lt;/font&gt;&lt;br&gt;&lt;br&gt;Pi GPIO17 pin 11 → 330Ω → LED1 blue anode&lt;br&gt;Pi GPIO27 pin 13 → 330Ω → LED2 yellow anode&lt;br&gt;Pi GPIO22 pin 15 → 330Ω → LED3 orange anode&lt;br&gt;Pi GPIO23 pin 16 → 330Ω → LED4 green anode&lt;br&gt;&lt;br&gt;LED cathodes → GND rail" style="rounded=1;shadow=1;strokeColor=#333333;fillColor=#FFFFFF;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="385" width="270" height="185" as="geometry" />
        </mxCell>
        <mxCell id="jacks" value="&lt;b&gt;CABLE SOCKET MATRIX&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Each wired contact goes directly to its own GPIO (no series resistor). Nothing on a socket goes to GND. Other contacts stay open.&lt;/font&gt;&lt;br&gt;&lt;br&gt;J1 (quad, 4-pin): pins 1-4 → GPIO4, 18, 24, 16&lt;br&gt;J2 (double, 2-pin): pin 1 → GPIO25, pin 2 → GPIO20&lt;br&gt;J3 (double, 2-pin): pin 1 → GPIO2, pin 2 → GPIO12&lt;br&gt;J4 (quad, 4-pin): contact 3 to GPIO3, contact 2 to GPIO7; contacts 1/4 unwired&lt;br&gt;&lt;br&gt;Cables bridge contacts; the Pi scans them (cable_matrix.py)." style="rounded=1;shadow=1;strokeColor=#333333;fillColor=#FFFFFF;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="600" width="270" height="210" as="geometry" />
        </mxCell>
        <mxCell id="gnd" value="&lt;b&gt;COMMON GROUND RAIL&lt;/b&gt;&lt;br&gt;Tie together: Pi GND, switch returns, and LED cathodes." style="rounded=1;shadow=1;strokeColor=#333333;fillColor=#E8E8F0;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="470" width="520" height="75" as="geometry" />
        </mxCell>
        <mxCell id="demo-cables" value="&lt;b&gt;DEMO CABLE PINOUTS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Historical decoder catalogue, not built inventory. Available: 4 quad + 2 dual connectors. Cable 1 built: quad 3 to dual 1; quad 4 to dual 2. Remaining builds unconfirmed.&lt;/font&gt;&lt;br&gt;&lt;table cellpadding=&quot;2&quot; style=&quot;font-size: 10px&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Cable 1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B3; A2→B4&lt;/td&gt;&lt;td&gt;&lt;b&gt;Cable 7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B4; A2→B3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Cable 2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B3; A2→B1&lt;/td&gt;&lt;td&gt;&lt;b&gt;Cable 8&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B1; A2→B3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Cable 3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B3; A2→B2&lt;/td&gt;&lt;td&gt;&lt;b&gt;Cable 9&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B2; A2→B3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Cable 4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B1; A2→B2&lt;/td&gt;&lt;td&gt;&lt;b&gt;Cable 10&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B2; A2→B1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Cable 5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B1; A2→B4&lt;/td&gt;&lt;td&gt;&lt;b&gt;Cable 11&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B4; A2→B1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Cable 6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B2; A2→B4&lt;/td&gt;&lt;td&gt;&lt;b&gt;Cable 12&lt;/b&gt;&lt;/td&gt;&lt;td&gt;A1→B4; A2→B2&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;shadow=1;strokeColor=#333333;fillColor=#D5E8D4;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="275" width="520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;BUILD NOTES&lt;/b&gt;&lt;br&gt;• Switch inputs use Pi internal pull-ups; a GPIO reads active when tied to GND.&lt;br&gt;• J1-J4 contacts are not tied to GND. Cables bridge contacts and the Pi scans for the bridges.&lt;br&gt;• Only J1 wires all four contacts. J4 wires 2 and 3 only. Cable 1: quad in J1; dual in J2/J3.&lt;br&gt;• Bench-test J4 pin 2 (GPIO7) first; it has only been proven as an output.&lt;br&gt;• Mode and device selection is controlled by the Power App; no selector wiring.&lt;br&gt;• Target wiring #112; verify physical rewire before updating/deploying config.py (J4 currently uses contacts 1/2)." style="rounded=1;shadow=1;strokeColor=#333333;fillColor=#FFFFFF;strokeWidth=2;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=10;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="570" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e-pi-sw" value="GPIO signal wires" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="pi" target="switches">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-pi-led" value="GPIO LED drive wires" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="pi" target="leds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-pi-jack" value="GPIO signal wires" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="pi" target="jacks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sw-gnd" value="returns to GND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="switches" target="gnd">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="755" y="232" /><mxPoint x="755" y="507" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e-led-gnd" value="LED cathodes to GND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontFamily=Helvetica;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="leds" target="gnd">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="755" y="477" /><mxPoint x="755" y="507" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="titleblock" value="&lt;b&gt;Title:&lt;/b&gt; Panel Pi Wiring&lt;br&gt;&lt;b&gt;Repo:&lt;/b&gt; Andworx/Copilot-IoT-Game&lt;br&gt;&lt;b&gt;Source:&lt;/b&gt; hardware/raspberry-pi/config.py&lt;br&gt;&lt;b&gt;Issue:&lt;/b&gt; #39" style="rounded=0;shadow=1;strokeColor=#333333;fillColor=#FFFFFF;strokeWidth=1;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="790" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="power-app-mode" value="&lt;b&gt;POWER APP MODE CONTROL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Device and game-mode choices come from the Power App/API.&lt;br&gt;&lt;br&gt;No additional Pi header wiring is required for mode selection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8F0;strokeColor=#333333;fontFamily=Helvetica;fontSize=12;shadow=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="150" width="520" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
