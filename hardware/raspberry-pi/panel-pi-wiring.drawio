        <mxCell id="wire11" value="RJ-45 shield, shell, and drain tabs stay disconnected from GND" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=16;align=left;spacing=12;" edge="0" parent="1" vertex="1">
