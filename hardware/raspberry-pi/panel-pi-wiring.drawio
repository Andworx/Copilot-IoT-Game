        <mxCell id="head2" value="&lt;b&gt;VALID SINGLE-CABLE LINKS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
