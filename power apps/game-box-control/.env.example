# Base URL of the azure/ Functions backend. Not a secret, but overridable
# for local dev against `func start`.
VITE_API_BASE_URL=https://func-aw-azcom-iot-game.azurewebsites.net

# set-mode's function key (az functionapp function keys list --function-name
# set-mode). This DOES end up in the built client bundle -- see
# src/apiConfig.ts's comment for why that's an accepted stopgap here.
VITE_SET_MODE_FUNCTION_KEY=

# toggle-device's function key (az functionapp function keys list --function-name
# toggle-device). Same stopgap posture as VITE_SET_MODE_FUNCTION_KEY.
VITE_TOGGLE_DEVICE_FUNCTION_KEY=

# set-game-mode's function key (az functionapp function keys list --function-name
# set-game-mode). Same stopgap posture as VITE_SET_MODE_FUNCTION_KEY.
VITE_SET_GAME_MODE_FUNCTION_KEY=

# bulk-create-prizes's function key (az functionapp function keys list --function-name
# bulk-create-prizes). Same stopgap posture as VITE_SET_MODE_FUNCTION_KEY.
VITE_BULK_CREATE_PRIZES_FUNCTION_KEY=

# grand-prize drawing endpoints' function key (az functionapp function keys list
# --function-name <grand-prize function name>). Same stopgap posture as
# VITE_SET_MODE_FUNCTION_KEY.
VITE_GRAND_PRIZE_DRAW_FUNCTION_KEY=

# grand-prize check-in endpoint's function key (az functionapp function keys list
# --function-name <grand-prize check-in function name>). Same stopgap posture as
# VITE_SET_MODE_FUNCTION_KEY.
VITE_GRAND_PRIZE_CHECK_IN_FUNCTION_KEY=
