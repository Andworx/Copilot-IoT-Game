{
  "schemaName": "andy_gamewin",
  "displayName": "Game Win",
  "displayCollectionName": "Game Wins",
  "description": "One row per resolved device fault. Created when Copilot Studio detects the fix; the claim token in the kiosk QR points a player's phone back at this row to spin for a prize. See power pages/PRIZE_ENGINE_SPEC.md §2.2/§3.",
  "primaryNameColumn": "andy_claimtoken",
  "ownership": "Organization",
  "isActivity": false,
  "changeTrackingEnabled": true,
  "columns": [
    {
      "schemaName": "andy_claimtoken",
      "displayName": "Claim Token",
      "dataType": "String",
      "maxLength": 100,
      "required": "Required",
      "description": "GUID encoded in the kiosk QR code. Single-use -- what /play-spin?token=... (now the prize wheel site's ?token=) reads. This is the primary name column since a gamewin row has no other natural display name."
    },
    {
      "schemaName": "andy_deviceprofile",
      "displayName": "Device Profile",
      "dataType": "Lookup",
      "target": "andy_deviceprofile",
      "required": "Required",
      "description": "Which item was fixed."
    },
    {
      "schemaName": "andy_status",
      "displayName": "Status",
      "dataType": "Choice",
      "choiceName": "andy_gamewinstatus",
      "required": "Required",
      "description": "Digital claim status -- Unclaimed/Claimed/Expired. See tables/choices/andy_gamewinstatus.json."
    },
    {
      "schemaName": "andy_redemptionstatus",
      "displayName": "Redemption Status",
      "dataType": "Choice",
      "choiceName": "andy_redemptionstatus",
      "required": "Required",
      "description": "Physical handoff status -- separate lifecycle from andy_status, see §2.3. See tables/choices/andy_redemptionstatus.json."
    },
    {
      "schemaName": "andy_redemptioncode",
      "displayName": "Redemption Code",
      "dataType": "String",
      "maxLength": 20,
      "required": "Optional",
      "description": "Short human-typeable code (GW-XXXXXX), generated at claim time. Null until claimed. Not the same value as andy_claimtoken -- the token is a bearer secret in a URL, this is read off a phone screen and typed by staff."
    },
    {
      "schemaName": "andy_wontime",
      "displayName": "Won Time",
      "dataType": "DateTime",
      "required": "Required",
      "description": "When the fix was detected."
    },
    {
      "schemaName": "andy_prize",
      "displayName": "Prize",
      "dataType": "Lookup",
      "target": "andy_prize",
      "required": "Optional",
      "description": "Null until claimed."
    },
    {
      "schemaName": "andy_claimedtime",
      "displayName": "Claimed Time",
      "dataType": "DateTime",
      "required": "Optional",
      "description": "Null until claimed."
    },
    {
      "schemaName": "andy_redeemedtime",
      "displayName": "Redeemed Time",
      "dataType": "DateTime",
      "required": "Optional",
      "description": "Null until a staff member fulfills it."
    },
    {
      "schemaName": "andy_redeemedby",
      "displayName": "Redeemed By",
      "dataType": "Lookup",
      "target": "andy_technician",
      "required": "Optional",
      "description": "Which staff member handed over the prize -- reuses the existing andy_technician table rather than inventing a new one."
    },
    {
      "schemaName": "andy_contestantname",
      "displayName": "Contestant Name",
      "dataType": "String",
      "maxLength": 200,
      "required": "Optional",
      "description": "Null if the player skips sharing."
    },
    {
      "schemaName": "andy_contestantemail",
      "displayName": "Contestant Email",
      "dataType": "String",
      "maxLength": 200,
      "required": "Optional",
      "description": "Null if the player skips sharing."
    },
    {
      "schemaName": "andy_sharedinfo",
      "displayName": "Shared Info",
      "dataType": "Boolean",
      "required": "Required",
      "description": "Whether the player opted in -- purely informational, never gates the spin/prize."
    }
  ]
}
