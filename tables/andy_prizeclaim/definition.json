{
  "schemaName": "andy_prizeclaim",
  "displayName": "Prize Claim",
  "displayCollectionName": "Prize Claims",
  "description": "Shared prize claim record for wins generated by IoT, Plinko, Claw Machine, and future games. For instant prizes, a claimed row represents booth fulfillment.",
  "primaryNameColumn": "andy_name",
  "ownership": "User",
  "isActivity": false,
  "changeTrackingEnabled": true,
  "columns": [
    {
      "schemaName": "andy_name",
      "displayName": "Claim Name",
      "description": "Primary display name for the prize claim, generated from the campaign, contest source, win time, or claim token.",
      "dataType": "String",
      "required": "Required",
      "maxLength": 850
    },
    {
      "schemaName": "andy_campaign",
      "displayName": "Campaign",
      "description": "Contest Campaign that owns eligibility rules for this claim.",
      "dataType": "Lookup",
      "required": "Recommended",
      "target": "andy_contestcampaign"
    },
    {
      "schemaName": "andy_contest_source",
      "displayName": "Contest Source",
      "description": "Contest Source that generated the win, such as IoT, Plinko, or Claw Machine.",
      "dataType": "Lookup",
      "required": "Recommended",
      "target": "andy_contestsource"
    },
    {
      "schemaName": "andy_contact",
      "displayName": "Contact",
      "description": "Contact linked when the player shares contact information during claim.",
      "dataType": "Lookup",
      "required": "Optional",
      "target": "contact"
    },
    {
      "schemaName": "andy_prize_instance",
      "displayName": "Prize Instance",
      "description": "Prize instance assigned to this claim. Prize type is inferred from the prize record.",
      "dataType": "Lookup",
      "required": "Optional",
      "target": "andy_prizes"
    },
    {
      "schemaName": "andy_claim_token",
      "displayName": "Claim Token",
      "description": "QR or bearer token used by a player to claim a prize.",
      "dataType": "String",
      "required": "Optional",
      "maxLength": 100
    },
    {
      "schemaName": "andy_claim_status",
      "displayName": "Claim Status",
      "description": "Digital claim lifecycle for the prize claim.",
      "dataType": "Choice",
      "required": "Required",
      "choiceName": "andy_prizeclaim_claimstatus",
      "defaultValue": 435700000
    },
    {
      "schemaName": "andy_claimed_time",
      "displayName": "Claimed Time",
      "description": "Timestamp when the player completed the claim.",
      "dataType": "DateTime",
      "required": "Optional"
    },
    {
      "schemaName": "andy_win_time",
      "displayName": "Win Time",
      "description": "Timestamp when the source game created the winning event.",
      "dataType": "DateTime",
      "required": "Recommended"
    }
  ]
}