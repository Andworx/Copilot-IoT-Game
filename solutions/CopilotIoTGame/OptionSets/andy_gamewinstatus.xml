      </Descriptions>
    </option>
    <option value="435700001" ExternalValue="" IsHidden="0">
      <labels>
        <label description="Claimed" languagecode="1033" />
      </labels>
      <Descriptions>
        <Description description="Claim endpoint ran: prize picked, andy_remaining decremented, andy_redemptioncode generated." languagecode="1033" />
      </Descriptions>
    </option>
    <option value="435700002" ExternalValue="" IsHidden="0">
      <labels>
        <label description="Expired" languagecode="1033" />
      </labels>
      <Descriptions>
