        &lt;/td&gt;
      &lt;/tr&gt;
    &lt;/table&gt;
  &lt;/body&gt;
&lt;/html&gt;]]&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</body>
